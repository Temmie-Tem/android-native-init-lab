# H0 RAM-only canary. Retain the broad r0q base, BLOCK and SMP.
CONFIG_LOCALVERSION="-g0q-ram-h0"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_BLOCK=y
CONFIG_SMP=y
CONFIG_DEVTMPFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INET=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_CMDLINE="rdinit=/init maxcpus=1 clk_ignore_unused pd_ignore_unused ignore_loglevel console=tty0 panic=0 log_buf_len=4M"
CONFIG_CMDLINE_FORCE=y
CONFIG_MODPROBE_PATH=""
CONFIG_UEVENT_HELPER_PATH=""
# CONFIG_SCSI_UFSHCD is not set
# CONFIG_PHY_QCOM_QMP_UFS is not set
# CONFIG_MMC is not set
# CONFIG_MTD is not set
# CONFIG_ATA is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_NVME_TARGET is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_UAS is not set
# CONFIG_USB_CONFIGFS_MASS_STORAGE is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_QCOM_WDT is not set
# CONFIG_GUNYAH_WATCHDOG is not set
# CONFIG_QCOM_QSEECOM is not set
# CONFIG_QCOM_QSEECOM_UEFISECAPP is not set
# CONFIG_CRYPTO_DEV_QCE is not set
# CONFIG_CRYPTO_DEV_QCOM_RNG is not set
# CONFIG_PSTORE is not set
# CONFIG_ACPI_APEI is not set
# CONFIG_EFI_VARS_PSTORE is not set
# CONFIG_CHROMEOS_PSTORE is not set
# CONFIG_REMOTEPROC is not set
# CONFIG_MFD_MAX77705 is not set
# CONFIG_CHARGER_MAX77705 is not set
# CONFIG_TYPEC is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_BT is not set
# CONFIG_WLAN is not set
# CONFIG_USB_DWC3_DUAL_ROLE is not set
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_CONFIGFS_FS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BUILD_SALT=""
CONFIG_SYSTEM_TRUSTED_KEYS=""
# Keep runtime symbols, but omit bulky host debug sections in this H0 build.
# CONFIG_DEBUG_INFO_DWARF5 is not set
CONFIG_DEBUG_INFO_NONE=y
