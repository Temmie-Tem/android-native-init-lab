+/* One host-side cable event; the registered gadget driver stays running. */
+static int vm_connect(const char *value, const struct kernel_param *param)
+{
+	struct dummy *dum;
+	struct dummy_hcd *hcd;
+	unsigned long flags;
+	int ret = 0;
+
+	if (!sysfs_streq(value, "1") || !the_udc_pdev[0])
+		return -EINVAL;
+	dum = platform_get_drvdata(the_udc_pdev[0]);
+	if (!dum)
+		return -ENODEV;
+	hcd = gadget_to_dummy_hcd(&dum->gadget);
+	spin_lock_irqsave(&dum->lock, flags);
+	if (vm_cable || !dum->vm_pullup_requested) {
+		ret = -EBUSY;
+	} else {
+		vm_cable = true;
+		dum->pullup = 1;
+		set_link_state(hcd);
+	}
+	spin_unlock_irqrestore(&dum->lock, flags);
+	if (!ret)
+		usb_hcd_poll_rh_status(dummy_hcd_to_hcd(hcd));
+	return ret;
+}
+
+static const struct kernel_param_ops vm_cable_ops = { .set = vm_connect };
