@@ -25,6 +29,10 @@
     if (fdt_getprop(fdt, chosen, "codex,uniloader-prefix-v1", &length) ||
         length != -FDT_ERR_NOTFOUND) return -FDT_ERR_EXISTS;
 #endif
+#ifdef G0Q_BOOT_TIMING
+    if (fdt_getprop(fdt, chosen, G0Q_TIMING_PROPERTY, &length) ||
+        length != -FDT_ERR_NOTFOUND) return -FDT_ERR_EXISTS;
