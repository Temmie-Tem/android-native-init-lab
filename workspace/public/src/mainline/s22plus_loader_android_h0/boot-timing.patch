+#ifdef G0Q_BOOT_TIMING
+#include "boot-timing.h"
+#endif
 #ifdef G0Q_LOGM_CONTROL
 void g0q_logm_control(void *fdt);
 #endif
@@ -16,6 +19,10 @@
 
 void arch_load_kernel(void* kernel, void* dt, void* ramdisk)
 {
+#ifdef G0Q_BOOT_TIMING
+	uint64_t frequency = g0q_timing_frequency();
+	uint64_t prepare_done = g0q_timing_ticks();
+#endif
 #ifndef G0Q_PREFIX_CONTROL
 	memcpy((void*)CONFIG_PAYLOAD_ENTRY, kernel, (unsigned long) &kernel_size);
 #endif
@@ -38,7 +45,13 @@
 	g0q_prefix_control(dt);
 	memcpy((void*)CONFIG_PAYLOAD_ENTRY, kernel, (unsigned long) &kernel_size);
 #endif
-#ifdef G0Q_LOGM_CONTROL
+#ifdef G0Q_BOOT_TIMING
+	uint64_t logm_begin = g0q_timing_ticks();
