     chosen = fdt_path_offset(buf, "/chosen");
@@ -40,5 +48,9 @@
     ret = fdt_setprop(buf, chosen, "codex,uniloader-prefix-v1", g0q_prefix_report_seed, 256);
     if (ret) return ret;
