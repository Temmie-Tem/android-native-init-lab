--- a/arch/aarch64/Makefile
+++ b/arch/aarch64/Makefile
@@ -3,7 +3,7 @@
 # Copyright (c) 2025 Ivaylo Ivanov <ivo.ivanov.ivanov1@gmail.com>
 
 obj-$(CONFIG_POSITION_INDEPENDENT) += aarch64/reloc.o
-obj-y += aarch64/start.o aarch64/load-kernel.o aarch64/memcpy.o
+obj-y += aarch64/start.o aarch64/load-kernel.o aarch64/memcpy.o aarch64/boot-timing.o
 
 # This leaf is called before any stack exists. All other C keeps the normal ABI.
 obj-y += aarch64/guard.o aarch64/logm-control.o aarch64/prefix-control.o aarch64/prefix-entry.o
--- a/arch/aarch64/reloc.S
+++ b/arch/aarch64/reloc.S
@@ -64,6 +64,11 @@
 	bl loader_guard
 	cbz x0, _reloc_rejected
 ENTRY_ALIAS(_guard_passed)
+#ifdef G0Q_BOOT_TIMING
+	/* x27 is preserved by the relocation/start stubs until main. */
+	isb
+	mrs x27, cntvct_el0
+#endif
 	adr x8, _head
 	adr x4, _stub_end
 	ldr x5, .Ldestination
--- a/arch/aarch64/start.S
+++ b/arch/aarch64/start.S
@@ -3,6 +3,7 @@
  * Copyright (c) 2022, Ivaylo Ivanov <ivo.ivanov.ivanov1@gmail.com>
  */
 #include "asmdefs.h"
+#include "g0q-android-marker.h"
 
 #ifdef CONFIG_LINUX_KRNL_HEADER_IMG
 #include "linux-kernel-image-header.h"
@@ -53,6 +54,9 @@
 	mov     x2, xzr
 #endif
 
+#ifdef G0Q_BOOT_TIMING
+	mov x3, x27
+#endif
 	bl main
 END(_start)
 
