--- a/arch/aarch64/reloc.S
+++ b/arch/aarch64/reloc.S
@@ -2,12 +2,14 @@
 /* g0q RAM canary: fixed staging, bounded file copy, no live-stub overwrite. */
 #include "asmdefs.h"
 #include "linux-kernel-image-header.h"
+#include "g0q-android-marker.h"
 
 .section .head.text, "ax"
 ENTRY_ALIAS(_head)
 	linux_image_header _reloc_entry
 
 ENTRY_ALIAS(_reloc_entry)
+	mov x28, x0
 	/* Only the reviewed MMU/cache-off, little-endian EL1/EL2 path. */
 	mrs x9, CurrentEL
 ENTRY_ALIAS(_reloc_check_el); cmp x9, #4
@@ -48,6 +50,23 @@
 	cmp x7, x12
 	b.hi .Lrange
 
+	/* Guard's PC-relative constants require an equal 4 KiB source slide.
+	 * It has no stack, calls, or stores; the build verifies its instructions.
+	 */
+	tst x8, #4095
+	b.ne _reloc_rejected
+	adr x1, _g0q_guard_plan
+	mov x2, x8
+	mov x3, x7
+	bl loader_guard
+	cbz x0, _reloc_rejected
+ENTRY_ALIAS(_guard_passed)
+	adr x8, _head
+	adr x4, _stub_end
+	ldr x5, .Ldestination
+	ldr x6, .Lcopy_size
+	add x7, x4, x6
+
 	cmp x4, x5
 	b.eq .Lsync
 	b.hi .Lbelow
@@ -85,6 +104,10 @@
 .Ldestination: .quad _stub_end
 .Lcopy_size:   .quad _copy_size
 .Lentry:       .quad _start
+ENTRY_ALIAS(_g0q_guard_plan)
+	.quad _head, _stack_end
+	.quad CONFIG_PAYLOAD_ENTRY, CONFIG_PAYLOAD_ENTRY + G0Q_VENDOR_RUNTIME
+	.quad CONFIG_DTB_ENTRY, CONFIG_DTB_ENTRY + CONFIG_FDT_BUF_SIZE
 ENTRY_ALIAS(_g0q_source_ram)
 #include "g0q-source-ram.inc"
 ENTRY_ALIAS(_g0q_source_ram_end)
--- a/arch/aarch64/start.S
+++ b/arch/aarch64/start.S
@@ -43,13 +43,14 @@
 2:
 
 	/* Fall through */
-	adrp    x0, dtb             /* Load page of dtb */
-	add     x0, x0, #:lo12:dtb  /* Add offset within the page */
+	mov     x0, x28            /* Actual current ABL FDT, preserved before relocation */
 	adrp    x1, kernel          /* Load page of kernel */
 	add     x1, x1, #:lo12:kernel /* Add offset within the page */
 #ifndef CONFIG_RAMDISK_NO_COPY
 	adrp    x2, ramdisk          /* Load page of kernel */
 	add     x2, x2, #:lo12:ramdisk /* Add offset within the page */
+#else
+	mov     x2, xzr
 #endif
 
 	bl main
--- a/arch/aarch64/Makefile
+++ b/arch/aarch64/Makefile
@@ -4,3 +4,7 @@
 
 obj-$(CONFIG_POSITION_INDEPENDENT) += aarch64/reloc.o
 obj-y += aarch64/start.o aarch64/load-kernel.o aarch64/memcpy.o
+
+# This leaf is called before any stack exists. All other C keeps the normal ABI.
+obj-y += aarch64/guard.o aarch64/logm-control.o
+CFLAGS_guard.o += -O2 -fpie -fno-stack-protector -fomit-frame-pointer -fno-jump-tables -ffixed-x28 -ffixed-x29 -ffixed-x30 -fcall-used-x19 -fcall-used-x20 -fcall-used-x21 -fcall-used-x22 -fcall-used-x23 -fcall-used-x24 -fcall-used-x25 -fcall-used-x26 -fcall-used-x27
