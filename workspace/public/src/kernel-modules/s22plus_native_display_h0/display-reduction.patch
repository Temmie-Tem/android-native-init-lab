--- /dev/null
+++ b/msm/samsung/ss_native_poc_disabled.c
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* H0 display variant: POC operations and device registration are unavailable. */
+#include "ss_dsi_panel_common.h"
+int ss_dsi_poc_init(struct samsung_display_driver_data *vdd)
+{
+    if (IS_ERR_OR_NULL(vdd))
+        return -ENODEV;
+    vdd->poc_driver.is_support = false;
+    vdd->panel_func.samsung_poc_ctrl = NULL;
+    return -EOPNOTSUPP;
+}
+int ss_poc_read_mca(struct samsung_display_driver_data *vdd)
+{
+    return -EOPNOTSUPP;
+}
+void ss_poc_comp(struct samsung_display_driver_data *vdd)
+{
+    /* POC is deliberately unsupported; never dispatch to panel callbacks. */
+}
--- /dev/null
+++ b/msm/samsung/ss_native_spi_disabled.c
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* H0 display variant: no DDI SPI registration, command transfer or programming. */
+#include "ss_dsi_panel_common.h"
+int ss_spi_write(struct spi_device *spi, int tx_bpw, u8 *tx_buf, int tx_size)
+{ return -EOPNOTSUPP; }
+int ss_spi_read(struct spi_device *spi, u8 *buf,
+    int tx_bpw, int rx_bpw, u8 *tx_buf, int tx_size, int rx_size)
+{ return -EOPNOTSUPP; }
+int ss_spi_sync(struct spi_device *spi, u8 *buf, enum spi_cmd_set_type type)
+{ return -EOPNOTSUPP; }
+void ss_panel_parse_spi_cmd(struct device_node *np,
+    struct samsung_display_driver_data *vdd)
+{ /* No command table is consumed. */ }
+struct ddi_spi_cmd_set *ss_get_spi_cmds(struct samsung_display_driver_data *vdd,
+    enum spi_cmd_set_type type)
+{ return NULL; }
+int ss_spi_init(struct samsung_display_driver_data *vdd)
+{
+    if (IS_ERR_OR_NULL(vdd))
+        return -ENODEV;
+    vdd->samsung_support_ddi_spi = false;
+    return -EOPNOTSUPP;
+}
+void ss_set_spi_speed(struct samsung_display_driver_data *vdd, int speed)
+{ /* No registered SPI device exists in this variant. */ }
