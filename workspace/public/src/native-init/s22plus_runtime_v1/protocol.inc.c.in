#define P345_SECCOMP_ARCH_OFFSET 4U
#define P345_SECCOMP_NR_OFFSET 0U
#define P345_SECCOMP_ARG0_OFFSET 16U
#define P345_SECCOMP_ARG1_OFFSET 24U
#define P345_SECCOMP_ARG2_OFFSET 32U

struct p345_rlimit {
    uint64_t current;
    uint64_t maximum;
};

struct p345_cap_header {
    uint32_t version;
    int32_t pid;
};

struct p345_cap_data {
    uint32_t effective;
    uint32_t permitted;
    uint32_t inheritable;
};

struct p345_sock_filter {
    uint16_t code;
    uint8_t jump_true;
    uint8_t jump_false;
    uint32_t constant;
};

struct p345_sock_fprog {
    uint16_t length;
    uint16_t padding;
    struct p345_sock_filter *filter;
};





























#define P345_BPF_ALLOW_SYSCALL(number) \
    {P345_BPF_JMP_JEQ_K, 0, 1, (number)}, \
    {P345_BPF_RET_K, 0, 0, P345_SECCOMP_RET_ALLOW}

#define P345_O_WRITE_MASK \
    (P345_O_WRONLY | P345_O_RDWR | P345_O_CREAT | P345_O_TRUNC | \
     P345_O_APPEND | P345_O_TMPFILE)




/* Fixed no-input API.  Call only after setsid/stdio setup and tty close. */


#undef P345_BPF_ALLOW_SYSCALL
#undef P345_O_WRITE_MASK


static long p328_dup_to(int source, int target) {
    return source == target ? target : sys_dup3(source, target, 0);
}

static long p328_setsid(void) {
    return syscall6(P328_NR_SETSID, 0, 0, 0, 0, 0, 0);
}
