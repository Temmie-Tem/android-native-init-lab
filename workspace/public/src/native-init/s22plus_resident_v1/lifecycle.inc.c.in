static void local_phase(unsigned phase) {
    if(local_owner() && !local_display.stopped && !local_display.terminal && phase<=8U)local_display.phase=phase;
}
static void local_service(void) {
    if(!local_owner())return;
    resident_reap(&local_display.abandoned_command);
    uint64_t now=0;
    if(rc1_now(&now) || now<local_display.last){local_display.terminal=1;local_close();return;}
    local_display.last=now;
    if(!local_display.stopped)hud1_tick(&local_display.hud,now,local_display.phase);
    else for(unsigned i=0;i<3;i++)resident_reap(&local_display.hud.child[i]);
