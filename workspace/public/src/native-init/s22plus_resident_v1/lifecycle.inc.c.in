       syscall6(176,0,0,0,0,0,0)==0 && syscall6(177,0,0,0,0,0,0)==0) {
        local_display.directory_rc=syscall6(34,-100,(long)(uintptr_t)"/s22-root-work",0700,0,0,0);
        if(!local_display.directory_rc)local_display.mount_rc=sys_mount("tmpfs","/s22-root-work","tmpfs",6UL,
            "size=64m,nr_inodes=4096,mode=0700");
        if(!local_display.mount_rc)hud1_start(&local_display.hud);
    }
    local_phase(3U);local_service();return 0;
}
static long local_write_all(int fd,const char *p,size_t size,long seconds) {
    struct timespec64 deadline={0};long rc=p282_deadline_after(seconds,&deadline);if(rc)return rc;
    while(size) {
        rc=local_pre_auth();if(rc)return rc;
        long n=sys_write(fd,p,size);
        if(n>0){if((size_t)n>size)return -EIO;p+=n;size-=(size_t)n;continue;}
        if(n!=-EAGAIN && n!=-P260_EINTR)return n?n:-EIO;
        if(p282_deadline_expired(&deadline))return -ETIMEDOUT;
        p282_poll_delay();
    }
    return 0;
}
static void resident_export_current(void) {resident_export(&local_display.hud);}
static void resident_abandon(struct rc1_state *s) {
    if(s->pid>0 && !s->reaped) {
        local_display.abandoned_command.pid=s->pid;
        local_display.abandoned_command.unknown=!!(s->flags&RC1_FLAG_WAIT_UNKNOWN);
    }
