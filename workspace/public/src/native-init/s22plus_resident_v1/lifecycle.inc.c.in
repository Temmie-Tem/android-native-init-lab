    long owner=syscall6(172,0,0,0,0,0,0);if(owner!=1)return -P260_EPROTO;
    local_display.owner=owner;local_display.started=1;
    local_display.hud.input=local_display.hud.output=local_display.hud.log=-1;
    local_display.hud.metrics[0]=local_display.hud.metrics[1]=-1;
    local_display.directory_rc=local_display.mount_rc=-P260_EPROTO;
    long rc=rc1_now(&local_display.start);if(rc)return rc;
    local_display.last=local_display.start;local_display.phase=6;
