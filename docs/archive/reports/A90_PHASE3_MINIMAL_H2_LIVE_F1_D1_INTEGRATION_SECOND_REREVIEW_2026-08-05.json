  "findings": [
    {
      "id": "D1-IDENTITY-005",
      "severity": "High",
      "status": "OPEN_BLOCKER",
      "finding": "a90_transition_d1_session_v1.verify_resident_health_exact rejects the exact H2 ordinary resident identity because its ordinary identity set is derived from staging.PHASE3_ALLOWED_STARTING_IDENTITIES minus PHASE2_ALLOWED_STARTING_IDENTITIES, and the Phase3 set contains only 0.9.285, 0.11.161, 0.11.167, and 0.11.168 identities, not H2 0.11.170/phase3-minimal-h2-two-phase-auto-benchmark.",
      "evidence": "A host-only direct invocation with resident_evidence_kind=ordinary-resident-install-v2 and the exact H2 version/build fails before bridge or device access with ContractError: D1 resident identity is not the exact V3406 baseline. The current transition and staging source hashes are ae1868e8cc547b120006a1e446938084fa46e265b5ffd032f1a38dafe5ab25df and c426037452f2d84be4bc7ae6f4dee04960d35b61456d168f3b5660fbfacd95a0.",
      "safety_effect": "The live H2 D1 runner cannot establish opening or final exact resident health through its selected ordinary resident path. Therefore the D1 transaction cannot satisfy its required HEALTHY barrier even though the benchmark runner ordering and host-only publication repairs are correct.",
      "required_fix": "Add the exact H2 version/build to the reviewed ordinary resident identity policy through the canonical identity source, bind the changed transitive execution closure, add positive H2 and negative wrong-identity regressions, and obtain a fresh independent rereview. Do not weaken the check to a prefix, version-only, build-only, or manifest-only match."
    }
  ],
