    "capability_semantics": [
      "get_status accepts a null output and otherwise zero-initializes the complete structure before assigning all thirteen string pointers to immutable non-null strings",
      "probe, play, and render_frame accept null outputs and otherwise return pid -1, rc -ENOTSUP, saved_errno ENOTSUP, zero status and duration, timed_out false, and CANCEL_NONE",
      "verify_wad, play, render_frame, and start_frame_loop_helper accept null outputs and otherwise return an empty non-null path, the caller expected hash or an empty non-null string, stat_errno ENOTSUP, empty arrays, zero sizes, and false validation booleans",
      "render_frame and read_frame_render accept null outputs and otherwise return an empty non-null path, stat_errno ENOTSUP, zero geometry and timestamps, and false validation booleans",
      "write_input_state and send_input_socket ignore both null and non-null input without writing a file or creating or sending on a socket",
      "start_frame_loop_helper never creates a process and sets a non-null pid output to -1",
      "every operational integer entry point returns -ENOTSUP for all argument values without changing errno",
      "the implementation contains no file, socket, process, payload, partition, device, or raw syscall path"
    ]
  },
