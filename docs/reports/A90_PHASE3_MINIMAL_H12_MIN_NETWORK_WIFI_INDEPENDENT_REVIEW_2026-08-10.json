{
  "capability": "A90_PHASE3_MINIMAL_H12_DIRECT_MIN_NETWORK_WIFI",
  "decision": "No unresolved HIGH, MEDIUM, or LOW finding. H12 preserves the direct Debian handoff and native fallback while carrying a minimal native Wi-Fi control plane across switch_root through a private mount namespace, shared network namespace, redacted read-only export, and advancing companion heartbeat.",
  "device_authority_granted": false,
  "findings": {
    "high": 0,
    "low": 0,
    "medium": 0,
    "resolved_before_final_review": [
      "Moved helper readiness after exact child, modem-holder, and wlan0 qualification and added a durable advancing heartbeat that disappears on failure.",
      "Restricted the Debian Wi-Fi export to status, resolv.conf, and companion regular files with exact metadata, size, and read-only mount checks.",
      "Moved the fast companion path ahead of legacy diagnostics, guarded duplicate modem ownership, and retained complete no-replay native fallback.",
      "Made the H12 benchmark prelude exact and required durable Wi-Fi ready, no-failure, and live-companion evidence.",
      "Rebuilt and rebound the final run07 rootfs and deterministic H12 A/B boot after the Wi-Fi evidence wait changed to 100 seconds.",
      "Updated the A90 F1 full-file CDC guard pin after the independently committed common guard changed, eliminating the deterministic host pre-session failure."
    ]
  },
